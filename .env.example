# Database
DATABASE_URL="postgresql://user:password@localhost:5432/repi?schema=public"

# Auth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Stack actual (docs/DECISIONS.md T02/T03). NEXTAUTH_* de arriba no se usan: se conservan por respeto al archivo existente.
BETTER_AUTH_SECRET="generar-con-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
# HMAC del DNI del padrón (T09). Secreto distinto del de auth.
ROSTER_HMAC_SECRET="generar-con-openssl-rand-base64-32"
# Base de pruebas de integración (se borra y recrea en cada corrida).
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/repi_test"
# Opcionales (D20). Sin estos valores los botones muestran "No disponible en este entorno".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
# Push web (D61). Generar con: npx web-push generate-vapid-keys. Sin estos valores los avisos quedan «skipped» y la bandeja sigue funcionando.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:soporte@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# Archivos privados en producción (D39). En desarrollo se usa apps/web/.storage.
STORAGE_DIR=""
