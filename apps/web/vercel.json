{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "crons": [
    {
      "path": "/api/cron/purge-media",
      "schedule": "30 6 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "claude/experience-3": true,
      "**": false
    }
  }
}
